# Disable caching for HTML files so changes are picked up immediately
<FilesMatch "\.(html|htm)$">
    FileETag None
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Jan 01 1970 00:00:00 GMT"
    </IfModule>
</FilesMatch>

# Enable caching for static assets with cache-busting query strings
<FilesMatch "\.(css|js|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=31536000, public"
    </IfModule>
</FilesMatch>
